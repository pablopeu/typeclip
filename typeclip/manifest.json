{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.1",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": ["debugger", "clipboardRead", "offscreen", "activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "type-clipboard": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "__MSG_cmdDesc__"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
