{
  "manifest_version": 3,
  "name": "TypeClip",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Lee el portapapeles y lo tipea caracter a caracter (eventos de teclado reales) en el campo con foco.",
  "permissions": ["debugger", "clipboardRead", "offscreen", "activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TypeClip — tipear el portapapeles (Alt+Shift+V)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "type-clipboard": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Tipear el contenido del portapapeles en el campo enfocado"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
